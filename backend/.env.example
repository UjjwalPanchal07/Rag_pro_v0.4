# backend/.env.example
# Copy to .env and fill in real values. NEVER commit .env to Git.

# ── MongoDB ────────────────────────────────────────────────────────────────
MONGO_URI=mongorurl

# ── JWT ────────────────────────────────────────────────────────────────────
SECRET_KEY=replace_this_with_64_char_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── First Admin ────────────────────────────────────────────────────────────
ADMIN_EMAIL=example@profinch.com
ADMIN_PASSWORD=your_strong_admin_password

# ── Frontend URL ───────────────────────────────────────────────────────────
APP_URL=http://localhost:5173

# ── Claude Haiku API (Web Search Summarisation & Translation) ──────────────
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ── Email (Optional) ───────────────────────────────────────────────────────
MAIL_SERVER=smtp.office.com
MAIL_PORT=586
MAIL_USERNAME=your_prism_mail@profinch.com
MAIL_PASSWORD=your_mail_password
MAIL_FROM=your_prism_mail@profinch.com
MAIL_FROM_NAME=PRISM System
